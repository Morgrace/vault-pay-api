# App
PORT=3000
NODE_ENV=development
# Where to send users after OAuth login completes
AUTH_REDIRECT_URL=http://localhost:5173
API_PREFIX=api/v1
# Database [PostgreSQL] — matches docker-compose.yml defaults
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=vaultpay

# Redis — matches docker-compose.yml defaults
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ — matches docker-compose.yml defaults
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=

# Brevo SMTP (https://app.brevo.com/settings/keys/smtp)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@vaultpay.com

# OAuth [Open Authorization] - Google
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OAuth [Open Authorization] - GitHub
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
